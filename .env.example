# Taigi Voice Video Web
# Copy to .env when you want local defaults loaded by taigi_web/server.py.

# External PostgreSQL export target used by Admin -> PostgreSQL backup.
# Example:
# TAIGI_WEB_POSTGRES_DSN=postgresql://taigi_user:change-me@postgres.example.com:5432/taigi
TAIGI_WEB_POSTGRES_DSN=
TAIGI_WEB_POSTGRES_SCHEMA=public

# Automatically schedule one lexicon entry without audio/video every 30 minutes.
TAIGI_WEB_WORD_AUTO_GENERATE_INTERVAL_SECONDS=1800
