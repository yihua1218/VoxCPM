# Taigi Voice Video Web
# Copy to .env when you want local defaults loaded by taigi_web/server.py.

# External PostgreSQL export target used by Admin -> PostgreSQL backup.
# Example:
# TAIGI_WEB_POSTGRES_DSN=postgresql://taigi_user:change-me@postgres.example.com:5432/taigi
TAIGI_WEB_POSTGRES_DSN=
TAIGI_WEB_POSTGRES_SCHEMA=public

# Automatically schedule one lexicon entry without audio/video every 30 minutes.
TAIGI_WEB_WORD_AUTO_GENERATE_INTERVAL_SECONDS=1800

# Public static snapshot output. Local development writes to taigi_web_jobs/public_static
# and serves it from /static-data. In production this can point at an S3/R2/GCS sync root
# and public CDN base URL, for example https://static.taigi.yihua.app.
TAIGI_WEB_PUBLIC_STATIC_DIR=
TAIGI_WEB_PUBLIC_STATIC_URL=/static-data

# Optional OpenAI-compatible Chat Completions API for random Chinese sentence generation.
# When unset, the web UI falls back to a local built-in sentence pool.
TAIGI_WEB_LLM_API_BASE_URL=
TAIGI_WEB_LLM_MODEL=
TAIGI_WEB_LLM_API_KEY=
