# Taigi Voice Video Web
# Copy to .env when you want local defaults loaded by taigi_web/server.py.

# External PostgreSQL export target used by Admin -> PostgreSQL backup.
# Example:
# TAIGI_WEB_POSTGRES_DSN=postgresql://taigi_user:change-me@postgres.example.com:5432/taigi
TAIGI_WEB_POSTGRES_DSN=
TAIGI_WEB_POSTGRES_SCHEMA=public

# Automatically schedule one lexicon entry without audio/video every 30 minutes.
TAIGI_WEB_WORD_AUTO_GENERATE_INTERVAL_SECONDS=1800

# Public static snapshot output. Local development writes to taigi_web_jobs/public_static
# and serves it from /static-data. In production this can point at an S3/R2/GCS sync root
# and public CDN base URL, for example https://static-taigi.yihua.app.
TAIGI_WEB_PUBLIC_STATIC_DIR=
TAIGI_WEB_PUBLIC_STATIC_URL=/static-data

# Frontend build/runtime option. Set this for public frontend deployments so
# anonymous browsing loads R2/S3 static snapshots first and only uses the backend
# after login or when submitting admin/create actions.
VITE_PREFER_STATIC_DATA=true
VITE_STATIC_DATA_BASE_URL=https://static-taigi.yihua.app/public
VITE_API_BASE_URL=https://api-taigi.yihua.app

# Backend CORS allowlist for browser calls to api-taigi.yihua.app.
TAIGI_WEB_CORS_ORIGINS=https://taigi.yihua.app,https://xn--kpr858j.yihua.app,http://localhost:5173,http://127.0.0.1:5174

# Optional S3/R2/GCS-compatible static sync target.
# The server uses AWS CLI: aws s3 sync "$TAIGI_WEB_PUBLIC_STATIC_DIR" s3://bucket/prefix
# Put credentials in the shell environment, ~/.aws/credentials, or the named AWS profile.
TAIGI_WEB_OBJECT_STORAGE_BUCKET=
TAIGI_WEB_OBJECT_STORAGE_PREFIX=taigi-public
TAIGI_WEB_OBJECT_STORAGE_ENDPOINT_URL=
TAIGI_WEB_OBJECT_STORAGE_REGION=
TAIGI_WEB_OBJECT_STORAGE_PROFILE=

# Optional OpenAI-compatible Chat Completions API for random Chinese sentence generation.
# When unset, the web UI falls back to a local built-in sentence pool.
TAIGI_WEB_LLM_API_BASE_URL=
TAIGI_WEB_LLM_MODEL=
TAIGI_WEB_LLM_API_KEY=

# Optional Taiwanese Hokkien translator backend for Chinese -> Taigi draft generation.
# Default is "rule", which keeps the built-in conservative phrase-map translator.
# Use "tw_hokkien_llm" with an OpenAI-compatible Completions endpoint, for example
# a local llama.cpp server serving a TW-Hokkien-LLM Translator model at /v1.
TAIGI_WEB_TRANSLATOR_BACKEND=rule
TAIGI_WEB_TRANSLATOR_API_BASE_URL=
TAIGI_WEB_TRANSLATOR_MODEL=
TAIGI_WEB_TRANSLATOR_API_KEY=
TAIGI_WEB_TRANSLATOR_TARGET_LANGUAGE=HAN
TAIGI_WEB_TRANSLATOR_TIMEOUT_SECONDS=90
